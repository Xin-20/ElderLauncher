<?xml version="1.0" encoding="utf-8"?>
<!-- 联系人卡片：上面是大照片（点照片直接打电话/视频），下面是小字称呼 + 小按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:padding="6dp"
    android:elevation="1dp">

    <!-- 大照片 + 底部半透明提示条 -->
    <FrameLayout
        android:id="@+id/photo_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_photo">

        <ImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="照片"
            android:src="@drawable/ic_person" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#66000000"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11dp"
            android:text="点照片就能打电话" />
    </FrameLayout>

    <!-- 称呼 + 小按钮 -->
    <LinearLayout
        android:id="@+id/name_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:textColor="@color/text_main"
            android:textSize="19dp"
            android:textStyle="bold"
            android:text="女儿" />

        <LinearLayout
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn_green_small"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="9dp">

            <ImageView
                android:id="@+id/button_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_phone_white" />

            <TextView
                android:id="@+id/button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13dp"
                android:textStyle="bold"
                android:text="打电话" />
        </LinearLayout>
    </LinearLayout>

    <!-- 号码 / 微信号（小字） -->
    <TextView
        android:id="@+id/value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:textColor="@color/text_sub"
        android:textSize="11dp"
        android:text="138 1234 5678" />

    <!-- 兼容旧代码，已不显示 -->
    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
